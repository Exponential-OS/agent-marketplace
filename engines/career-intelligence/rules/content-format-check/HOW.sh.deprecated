#!/usr/bin/env bash
# HOW.sh — content-format-check enforcement
#
# Usage: bash HOW.sh '{"text": "...", "platform": "substack|linkedin|twitter|reddit|instagram"}'
#
# platform is optional — omit for universal checks only
# Exit: 0=PASS  1=BLOCK  2=WARN
#
# Delegates all pattern matching to check.py (Python: portable, unicode-safe, special-char safe)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="$HOME/.cyborg-enforcement-log.jsonl"

# Support both direct call (HOW.sh '<json>') and dispatch.sh pipe (HOW.sh -)
if [[ "${1:-}" == "-" ]]; then
  CONTEXT="$(cat)"
else
  CONTEXT="${1:-}"
fi

if [[ -z "$CONTEXT" ]]; then
  echo '{"verdict":"BLOCK","reason":"No input. Pass JSON: {\"text\":\"...\",\"platform\":\"substack|linkedin|twitter|reddit|instagram\"}"}'
  exit 1
fi

RESULT=$(python3 "$SCRIPT_DIR/check.py" "$CONTEXT")
EXIT_CODE=$?

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
echo "{\"timestamp\":\"$TIMESTAMP\",\"rule\":\"content-format-check\",\"result\":$RESULT}" >> "$LOG_FILE"

echo "$RESULT"
exit $EXIT_CODE
